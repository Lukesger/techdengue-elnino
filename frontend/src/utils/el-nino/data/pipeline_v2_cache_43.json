as ficam mais irregulares. No passado, isso coincidiu com mais casos de dengue.","A combinacao calor + umidade + agua parada explica a maior parte do crescimento de casos observado nos 1 municipios ARAGUARI."]},"copernicus":{"conectado":false,"motivo":"Token CDS nao configurado","fonte":"Copernicus CDS"},"techdengue_api":{"configurado":true,"conectado":true,"fonte":"TechDengue API","docs":"https://api.sistematechdengue.com/api/docs","usuario":"apileitura@techdengue.com","baseUrl":"https://api.sistematechdengue.com"},"fontes":["TechDengue API — municipios geograficos (contrato 43)","NOAA — NOAA CPC (ONI ascii)","Infodengue AlertCity — casos mensais (1 municipios ARAGUARI, ate Jul/2026)","Open-Meteo Archive — clima historico (fallback)","TechDengue API — apileitura@techdengue.com","IBGE Localidades — validacao geocodes MG","IBGE Malhas v3 (1 mun.) — mapa choropleth (1 municipios)","Copernicus CDS — clima municipal (ERA5 + projeção)","Infodengue AlertCity — alertas epidemiologicos","INMET WIS2 — API OGC conectada"],"avisos":["Copernicus CDS: Script CDS ausente: C:\\Users\\Aero.Process 03\\Desktop\\Lucas Aero\\Eu\\scripts\\cds_clima_icismep.py","Copernicus CDS: use cache ERA5 ou configure token em copernicus.api.txt"],"municipios_foco":["Araguari"],"ano_inicio":2022,"ano_fim":2026,"mes_inicio":1,"mes_fim":7,"anos_janela":5,"periodo_rotulo":"Jan/2022–Jul/2026","consultado_em":"2026-07-01T13:07:44.212Z","versao":2,"cache_atualizado_em":"2026-07-01T13:07:55.826Z"}}