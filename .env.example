# Copie para credenciais.env e preencha. NUNCA commite credenciais.env no monorepo.

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_MAPBOX_TOKEN=

# Backend
NODE_ENV=development
PORT=8000
API_PREFIX=api/v1
CORS_ORIGIN=http://localhost:3001
ELNINO_DEMO_AUTH=true
ELNINO_ANALYTICS_CRON_ENABLED=false

# JWT (opcional no modo demo)
JWT_SECRET=
JWT_REFRESH_SECRET=

# PostgreSQL (opcional — modo slim usa municípios foco sem DB)
DB_HOST=
DB_PORT=5432
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
DB_SSL=false

DADOS_GEO_DB_HOST=
DADOS_GEO_DB_PORT=5432
DADOS_GEO_DB_USERNAME=
DADOS_GEO_DB_PASSWORD=
DADOS_GEO_DB_NAME=
DADOS_GEO_DB_SCHEMA=dados_geograficos

GIS_DB_HOST=
GIS_DB_PORT=5432
GIS_DB_USERNAME=
GIS_DB_PASSWORD=
GIS_DB_NAME=

# Copernicus CDS (opcional)
CDSAPI_KEY=
CDSAPI_URL=
