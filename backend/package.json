{
  "name": "techdengue-elnino-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Backend slim El Niño Analytics (monorepo)",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "el-nino:oni-atual": "node --use-system-ca scripts/consultar-oni-atual.js",
    "el-nino:oni-atual:instalar-tarefa": "powershell -ExecutionPolicy Bypass -File scripts/install-oni-weekly-task.ps1",
    "el-nino:oni-atual:remover-tarefa": "powershell -ExecutionPolicy Bypass -File scripts/install-oni-weekly-task.ps1 -Remove"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/swagger": "^11.4.6",
    "axios": "^1.12.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "dotenv": "^16.3.1",
    "fast-xml-parser": "^5.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@types/node": "^22.10.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  }
}
